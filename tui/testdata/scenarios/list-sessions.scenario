# The other non-interactive path: --list-sessions answers and exits 0. It is the
# cheapest end-to-end check of the CLI surface, and it runs against a throwaway session
# directory so it never reads the real one.
#
# The assertion is a session id, not the "Available sessions:" header: the list can be
# longer than the terminal, the header is its first line, and the screen shows the end —
# which is what a real terminal shows too.
open --dir . --size 100x10 --env HOME=/tmp/tinyscen-home --env TERM=xterm-256color --env CLICOLOR_FORCE=1 --env NO_COLOR -- ./bin/tinycode --list-sessions --session-dir=/tmp/tinyscen-home/sessions --log-level=error
wait --text "TUI-2" --timeout 20s
wait-exit 15s
expect-exit 0
