# The tool loop, with a local model: the stub (asked for "tool" mode) returns one bash
# tool call and then a final answer, so the loop terminates after one round instead of
# calling the tool forever — which is what a stub that answers the same way every time
# does, and what the first capture of this path showed (steps 6 through 19, all
# "calling tools: bash").
#
# The two assertions are the loop's two halves: the tool call reached the tool loop, and
# the model's final answer was rendered after the tool result came back.
open --dir . --size 120x30 --env HOME=/tmp/tinyscen-home --env TERM=xterm-256color --env COLORTERM=truecolor --env CLICOLOR_FORCE=1 --env NO_COLOR -- /bin/sh -c 'python3 tui/testdata/stub/openai_stub.py 18482 tool & sleep 1; ./bin/tinycode "run the stub tool" --api-key=stub --base-url=http://127.0.0.1:18482/v1 --model=stub --session-dir=/tmp/tinyscen-home/sessions --log-level=error; status=$?; kill %1 2>/dev/null; exit $status'
wait --text "calling tools: bash" --timeout 30s
wait --text "stub-final-ok" --timeout 30s
screenshot /tmp/tinyscen-shots/tool-call-120x30.png --scale 2
wait-exit 15s
expect-exit 0
