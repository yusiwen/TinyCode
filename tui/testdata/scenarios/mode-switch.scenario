# Switching agent mode through the command path. The assertion is the status bar's
# own label: the welcome banner also contains the word "build" (/plan /build), so the
# scenario waits for "⚡ build" — the mode indicator, not the menu entry.
open --dir . --size 120x40 --env HOME=/tmp/tinyscen-home --env TERM=xterm-256color --env COLORTERM=truecolor --env CLICOLOR_FORCE=1 --env NO_COLOR -- ./bin/tinycode --api-key=scenario --base-url=http://127.0.0.1:9/v1 --model=scenario --session-dir=/tmp/tinyscen-home/sessions --log-level=error
wait --text "Get started" --timeout 20s
send --text /build
send --key enter
wait --text "⚡ build" --timeout 10s
screenshot /tmp/tinyscen-shots/mode-build-120x40.png --scale 2
send --key ctrl+c --key ctrl+c
wait-exit 15s
expect-exit 0
