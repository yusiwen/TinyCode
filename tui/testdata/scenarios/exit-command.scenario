# "/exit" is two lines of code — persistSession() then tea.Quit (tui/update.go:1031) — and
# this covers the documented way out that is neither Ctrl+C nor closing the terminal. It is
# also the first scenario that ends on a *command* rather than a key chord.
#
# The readiness wait is not decoration: an earlier attempt typed /exit before the input row
# accepted keys, the command was lost, and the run timed out — the flake in issue #102.
open --dir . --size 120x30 --env HOME=/tmp/tinyscen-home --env TERM=xterm-256color --env COLORTERM=truecolor --env CLICOLOR_FORCE=1 --env NO_COLOR -- ./bin/tinycode --api-key=scenario --base-url=http://127.0.0.1:9/v1 --model=scenario --session-dir=/tmp/tinyscen-home/sessions --log-level=error
wait --text "Get started" --timeout 20s
wait --text "Type your request" --timeout 20s
send --text /exit
send --key enter
wait-exit 15s
expect-exit 0
